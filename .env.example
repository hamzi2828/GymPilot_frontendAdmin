# The GymPilot API (GymPilot_backend). The panel talks to /api/platform on it
# and the marketing site reads public plans / posts demo requests there.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Where this site is served. Used for canonical URLs, Open Graph and the
# sitemap. The API needs the same value in PLATFORM_ADMIN_ORIGIN so it accepts
# the panel's requests (CORS) and points password-reset links here.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# How people reach you. Each one appears wherever the site offers contact
# (header, hero, footer, demo and contact forms, checkout and its result
# pages) once it is set; the contact form at /contact works without any.
# Set at least the WhatsApp number before running ads.
#   WHATSAPP_NUMBER  in international form, country code first, no leading
#                    zero: 923001234567 (spaces, + and dashes are ignored)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Who sells GymPilot, for the legal pages (/terms, /privacy, /refund-policy)
# and the footer. Each line appears on the site only when it is set, so set
# them all before taking money. The pages themselves are drafts in
# src/content/legal.ts: have them reviewed first.
#   NAME           the person or company that sells GymPilot, as registered
#   ADDRESS        its postal address, on one line
#   EMAIL          where legal and privacy questions go (defaults to
#                  NEXT_PUBLIC_CONTACT_EMAIL)
#   GOVERNING_LAW  read after "the laws of", e.g. Pakistan
#   JURISDICTION   read after "the courts of", e.g. Lahore
#   HOSTING_REGION read after "The servers are in", e.g. Singapore -- where
#                  the database cluster and the Vercel functions run
#   UPDATED        the date the pages were last changed, e.g. 9 October 2026
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_GOVERNING_LAW=
NEXT_PUBLIC_LEGAL_JURISDICTION=
NEXT_PUBLIC_LEGAL_HOSTING_REGION=
NEXT_PUBLIC_LEGAL_UPDATED=

# Where a gym's own website / member portal lives when you want to link to a
# live example from the marketing site. Optional.
NEXT_PUBLIC_DEMO_GYM_URL=

# One-tap super admin sign-in: open /login?quick=1 under `next dev` and the
# form fills itself from these. Server-side only (no NEXT_PUBLIC_ prefix, so
# they never reach the browser bundle) and served by /api/dev-login, which
# answers only when NODE_ENV=development. Both must be set for the shortcut
# to appear; leave them unset on any deployment.
DEV_SUPER_ADMIN_EMAIL=
DEV_SUPER_ADMIN_PASSWORD=
